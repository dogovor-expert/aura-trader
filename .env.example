# Aura Trader — образец переменных окружения.
# Скопируй в .env (или задай в системе) и заполни. Файл .env в репозиторий не попадает.

# Пароль keystore Hummingbot (нужен, чтобы запускать стратегию в контейнере).
HBOT_PASSWORD=

# LLM-провайдеры. Система берёт ключ из переменной окружения; достаточно одного.
ANYMODEL_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=